{
  "cli": {
    "version": ">= 24.10.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.getflicko.tech",
        "EXPO_PUBLIC_CLUSTER": "devnet",
        "EXPO_PUBLIC_RPC_URL": "https://api.devnet.solana.com"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.getflicko.tech",
        "EXPO_PUBLIC_CLUSTER": "devnet",
        "EXPO_PUBLIC_RPC_URL": "https://api.devnet.solana.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
