{
  "expo": {
    "name": "Flicko",
    "slug": "flicko",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app/icon.png",
    "scheme": "flicko",
    "userInterfaceStyle": "dark",
    "ios": {},
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E0B14",
        "foregroundImage": "./assets/app/android-icon-foreground.png",
        "backgroundImage": "./assets/app/android-icon-background.png",
        "monochromeImage": "./assets/app/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.flicko.mobile"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/app/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0E0B14"
        }
      ],
      "expo-image",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Flicko lets you pick a photo for your profile picture.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Flicko uses your camera to turn moments into memes. Nothing is posted until you tap Post.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF2D95"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Flicko saves your memes to your gallery when you tap Save.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-dev-client",
        {
          "toolsButton": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0E0B14",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "105750e2-e91c-4d97-8c34-ccf9c444a617"
      }
    }
  }
}
