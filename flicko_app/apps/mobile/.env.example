# Copy to .env (gitignored). The phone must reach the server: use your laptop's LAN IP
# (e.g. http://192.168.1.20:3000) or a tunnel URL, not localhost.
EXPO_PUBLIC_API_URL=http://192.168.1.20:3000
EXPO_PUBLIC_CLUSTER=devnet
EXPO_PUBLIC_RPC_URL=https://api.devnet.solana.com
# Optional: defaults to the skrMint in flicko_app/config/devnet.json
# EXPO_PUBLIC_SKR_MINT=
# Optional: 1 = Markets and meme detail use the kit's mock data (src/mocks)
# EXPO_PUBLIC_USE_MOCKS=1
